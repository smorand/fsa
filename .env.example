# fsa local secrets -- copy to .env and fill in. .env is gitignored.
# run.sh sources .env automatically.

# MinIO / S3 blob backend (config/minio.yaml.template uses ${FSA_MINIO_SECRET_KEY})
FSA_MINIO_ENDPOINT=http://127.0.0.1:9000
FSA_MINIO_ACCESS_KEY=admin
FSA_MINIO_SECRET_KEY=

# GitHub App device flow (git.auth provider=github)
FSA_GITHUB_CLIENT_SECRET=

# OAuth token persistence (optional). If unset, tokens are in-memory only.
# Generate with: openssl rand -base64 32
FSA_TOKEN_KEY=
